---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import hero from '../../assets/hero.jpg';

// Фото 3:2 заполняет экран через object-fit: cover: в окне уже 3:2 ширину задаёт высота экрана (150vh),
// и по одной ширине окна браузер взял бы слишком маленький вариант — фото вышло бы мыльным.
const heroSizes = '(max-aspect-ratio: 3/2) 150vh, 100vw';
---
<section class="hero">
  <Image src={hero} alt="Остекление жилого дома — объект Стекляники" class="hero__bg" widths={[768, 1280, 1920, 2560]} sizes={heroSizes} loading="eager" fetchpriority="high" />
  <div class="hero__shade"></div>

  <div class="hero__content">
    <h1 class="hero__title">
      <span class="hero__title-bold">Светопрозрачные<br />конструкции</span>
      <span class="hero__title-light">под ключ</span>
    </h1>
    <p class="hero__text">Проектирование, производство и монтаж стеклянных решений для&nbsp;коммерческих и частных объектов</p>
    <button type="button" class="btn btn--glass hero__cta" data-lead="Запросить расчёт проекта">
      Запросить расчёт проекта <Icon name="arrow-right" size={18} stroke={1.25} />
    </button>
  </div>

  <a href="#about" class="hero__down" aria-label="К разделу «О компании»"><Icon name="arrow-down" size={22} stroke={1} /></a>
</section>

<style>
  .hero { position: relative; min-height: clamp(560px, 100svh, 900px); display: flex; align-items: center; overflow: hidden; background: var(--green-900); color: #fbfdff; }
  .hero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; transform: scale(1.04); animation: hero-zoom 14s var(--ease) forwards; }
  @keyframes hero-zoom { to { transform: scale(1); } }
  /* Подложка — «Зелёный мох», затемнённый на четверть (46,56,54 = #3d4a47 × 0.75): чистый мох светлее фото и делал его мутным,
     тёмный даёт глубину (пользователь просил «чуть-чуть» — прозрачность прежняя) */
  .hero__shade {
    position: absolute; inset: 0;
    background:
      /* текст стоит ближе к центру — притемняем всю левую половину, чтобы взгляд шёл сначала на текст */
      linear-gradient(0deg, rgba(46,56,54,.1) 0%, rgba(46,56,54,0) 65%),
      linear-gradient(90deg, rgba(46,56,54,.74) 0%, rgba(46,56,54,.6) 38%, rgba(46,56,54,.18) 78%, rgba(46,56,54,.1) 100%),
      linear-gradient(180deg, rgba(46,56,54,.45) 0%, rgba(46,56,54,0) 22%);
  }
  /* Текст выровнен по общей сетке сайта (как секции ниже) — ближе к центру, и опущен ниже шапки */
  .hero__content {
    position: relative; width: 100%; max-width: calc(var(--container) + var(--gutter) * 2); margin-inline: auto;
    padding: calc(var(--header-h) + clamp(60px, 9vh, 120px)) var(--gutter) 90px;
  }
  .hero__title { display: grid; text-transform: uppercase; color: #fbfdff; }
  .hero__title-bold { font-weight: 700; font-size: clamp(36px, 4.2vw, 80px); line-height: 1.25; letter-spacing: -0.015em; }
  .hero__title-light { font-weight: 300; font-size: clamp(32px, 3.65vw, 70px); line-height: 1.43; letter-spacing: .017em; margin-left: -.05em; }
  .hero__text { max-width: 560px; margin-top: clamp(28px, 5.5vw, 100px); font-weight: 300; font-size: clamp(16px, 1.05vw, 20px); line-height: 1.3; color: rgba(251,253,255,.9); }
  .hero__cta { margin-top: 32px; }
  .hero__down {
    position: absolute; left: 50%; bottom: 22px; translate: -50% 0;
    display: grid; place-items: center; width: 41px; height: 40px; border-radius: 100px;
    border: 1px solid rgba(251,253,255,.5); color: #fbfdff; transition: background .25s, color .25s;
    animation: bob 2.4s ease-in-out infinite;
  }
  .hero__down:hover { background: #fbfdff; color: var(--green-900); }
  @keyframes bob { 50% { transform: translateY(6px); } }

  @media (max-width: 860px) { .hero__down { bottom: 40px; } }
  @media (max-width: 640px) {
    .hero { align-items: flex-end; }
    .hero__content { padding-bottom: 96px; }
    .hero__title-bold { font-size: clamp(27px, 8.4vw, 40px); }
    .hero__title-light { font-size: clamp(26px, 8vw, 38px); }
    .hero__cta { width: 100%; justify-content: center; }
    /* как на десктопе — слева направо: тёмный левый край под текстом, к правому краю светлеет; сверху лёгкая тень под шапку */
    .hero__shade {
      background:
        linear-gradient(90deg, rgba(46,56,54,.82) 0%, rgba(46,56,54,.66) 50%, rgba(46,56,54,.38) 100%),
        linear-gradient(180deg, rgba(46,56,54,.4) 0%, rgba(46,56,54,0) 22%);
    }
  }
  @media (prefers-reduced-motion: reduce) { .hero__bg, .hero__down { animation: none; transform: none; } }
</style>
