---
// Первый экран внутренних страниц: фото, хлебные крошки, заголовок, подзаголовок и подпись справа.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  title: string;
  text?: string;
  image?: ImageMetadata;
  collage?: { image: ImageMetadata; position?: string; mobile?: string }[]; // вместо image — 3 фото («Услуги») или 2 фото («Вакансии») рядом, стыки по диагонали; mobile — object-position на телефоне
  crumbs?: { label: string; href?: string }[];
  aside?: string;       // подпись справа, перенос строки — через \n
  position?: string;    // object-position фото
  tall?: boolean;       // на всю высоту окна на компьютере (на телефоне и планшете такой высоты все первые экраны)
  down?: string;        // якорь следующего экрана ('#history') — внизу появится круглая кнопка со стрелкой, как на главной
  downMobileOnly?: boolean; // кнопка «вниз» только на телефоне и планшете (страницы, где на компьютере экран низкий и кнопки нет)
  zoom?: boolean;       // при открытии фото медленно приближается (тот же приём, что у фото на главной)
  mobilePosition?: string; // object-position фото на телефоне и планшете — какую часть кадра показать на вертикальном экране
  mobileShort?: boolean; // на телефоне и планшете экран на 2/3 высоты окна, заголовок ближе к низу («События»)
  mobileLow?: boolean;  // на телефоне и планшете низкий экран с заголовком внизу, не на всю высоту (смежные страницы — вакансии)
  mobileTitleLow?: boolean; // на телефоне и планшете заголовок на высоте описаний других страниц («Объекты»: описания нет, под заголовком было пусто)
  quality?: number;     // качество WebP для image (по умолчанию сжатие Astro — заметно сглаживает кожу и ткань на фото людей)
  imageSizes?: string;  // свой sizes для image, если фото должно подбираться и по высоте экрана
}
const { title, text, image, collage, crumbs = [], aside, position = 'center', tall = false, down, downMobileOnly = false, zoom = false, mobilePosition, mobileShort = false, mobileLow = false, mobileTitleLow = false, quality, imageSizes } = Astro.props;
const all = [{ label: 'Главная', href: '/' }, ...crumbs];
---
<section class:list={['phero', { 'phero--tall': tall, 'phero--down': down && !downMobileOnly, 'phero--zoom': zoom, 'phero--collage': collage, 'phero--collage-2': collage?.length === 2, 'phero--mshort': mobileShort, 'phero--mlow': mobileLow, 'phero--mtitle-low': mobileTitleLow }]}>
  {image && <Image src={image} alt="" class="phero__bg" widths={[768, 1280, 1920, 2560]} sizes={imageSizes ?? (mobileLow ? '100vw' : '(max-width: 860px) 200vw, 100vw')} quality={quality} loading="eager" fetchpriority="high" style={`--pos:${position};--pos-m:${mobilePosition ?? position}`} />}
  {collage && (
    <div class="phero__collage">
      {collage.map((c, i) => (
        <div class={`phero__piece phero__piece--${i + 1}`}>
          <Image src={c.image} alt="" class="phero__pimg" widths={[480, 800, 1200, 1600, 2000]} quality={90} sizes="(max-width: 860px) 200vw, 100vw" loading="eager" fetchpriority={i === 0 ? 'high' : 'auto'} style={`--pos:${c.position ?? 'center'};--pos-m:${c.mobile ?? c.position ?? 'center'}`} />
        </div>
      ))}
    </div>
  )}
  <div class="phero__shade"></div>
  <div class="container phero__inner">
    <nav class="phero__crumbs" aria-label="Хлебные крошки">
      {all.map((c, i) => (
        <>
          {c.href && i < all.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
          {i < all.length - 1 && <span class="phero__sep">/</span>}
        </>
      ))}
    </nav>
    <div class="phero__head">
      <h1 class="phero__title">{title}</h1>
      {text && <p class="phero__text">{text}</p>}
    </div>
    <slot />
  </div>
  {aside && <p class="phero__aside">{aside.split('\n').map((l, i, a) => <>{l}{i < a.length - 1 && <br />}</>)}</p>}
  {down && <a href={down} class:list={['phero__down', { 'phero__down--mobile': downMobileOnly }]} aria-label="К следующему разделу"><Icon name="arrow-down" size={22} stroke={1} /></a>}
</section>

<style>
  .phero { position: relative; min-height: clamp(420px, 52vw, 600px); display: flex; align-items: flex-end; overflow: hidden; background: var(--green-900); color: #fff; }
  .phero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: var(--pos); }
  /* Фото растянуто на весь вертикальный экран, поэтому браузеру нужен файл шире окна (sizes 200vw), иначе мыльно */
  @media (max-width: 860px) { .phero__bg { object-position: var(--pos-m); } }
  /* Коллаж: три фото, стыки по диагонали (трапеции), без рамок между ними.
     Фото лежат слоями: 1-е целиком, 2-е поверх него, 3-е поверх 2-го — обрезается только левый край верхнего слоя,
     а под ним всегда соседнее фото, поэтому на стыке не проступает тёмный фон.
     --a/--b — стыки вверху, сдвинутые на --s внизу. brightness подобран пользователем: +10 %, затем −6 %, −5 %, −3 %, −5 % и −5 % (1.1 × 0.94 × 0.95 × 0.97 × 0.95 × 0.95 ≈ 0.86). */
  .phero__collage { --a: 37%; --b: 70%; --s: 7%; position: absolute; inset: 0; filter: brightness(0.86); }
  .phero__piece { position: absolute; inset: 0; }
  /* Фото коллажа заполняют полосу по высоте экрана, поэтому видимая ширина кадра больше ширины полосы —
     sizes с запасом (100vw / 200vw), чтобы браузер брал фото в полном размере, а не растягивал уменьшенное (было мыльно) */
  .phero__pimg { position: absolute; top: 0; height: 100%; object-fit: cover; object-position: var(--pos); }
  @media (max-width: 860px) { .phero__pimg { object-position: var(--pos-m); } }
  .phero__piece--1 .phero__pimg { left: 0; width: var(--a); }
  .phero__piece--2 { clip-path: polygon(var(--a) 0, 100% 0, 100% 100%, calc(var(--a) - var(--s)) 100%); }
  .phero__piece--2 .phero__pimg { left: calc(var(--a) - var(--s)); width: calc(var(--b) - var(--a) + var(--s)); }
  .phero__piece--3 { clip-path: polygon(var(--b) 0, 100% 0, 100% 100%, calc(var(--b) - var(--s)) 100%); }
  .phero__piece--3 .phero__pimg { left: calc(var(--b) - var(--s)); width: calc(100% - var(--b) + var(--s)); }
  @media (max-width: 860px) { .phero__collage { --a: 38%; --b: 72%; --s: 12%; } }
  /* На телефоне из трёх фото («Услуги») остаются два — первое и третье, стык посередине: три полосы были слишком узкими
     (просьба пользователя). Третье фото узкое вертикальное — в полосу помещается лучше широкого среднего */
  @media (max-width: 640px) {
    .phero--collage:not(.phero--collage-2) .phero__collage { --a: 52%; --b: var(--a); }
    .phero--collage:not(.phero--collage-2) .phero__piece--2 { display: none; }
  }
  /* Два фото («Вакансии»): первое — команда — широкое, чтобы в кадр помещались все пятеро; стык правее середины, второе фото — до правого края */
  .phero--collage-2 .phero__collage { --a: 76%; } /* при 62 % косая граница резала девушку справа на фото команды */
  @media (max-width: 860px) { .phero--collage-2 .phero__collage { --a: 68%; } }
  .phero--collage-2 .phero__piece--2 .phero__pimg { width: calc(100% - var(--a) + var(--s)); }
  /* У коллажа затемнение слабее — только чтобы читался текст слева */
  .phero--collage .phero__shade { background: linear-gradient(90deg, rgba(15,36,38,.5) 0%, rgba(15,36,38,.15) 50%, rgba(15,36,38,0) 100%), linear-gradient(180deg, rgba(15,36,38,.35) 0%, rgba(15,36,38,0) 20%); }
  .phero__shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(15,36,38,.82) 0%, rgba(15,36,38,.45) 55%, rgba(15,36,38,.2) 100%), linear-gradient(180deg, rgba(15,36,38,.55) 0%, rgba(15,36,38,0) 30%); }
  .phero__inner { position: relative; padding-top: calc(var(--header-h) + 48px); padding-bottom: clamp(48px, 6vw, 88px); }
  .phero__crumbs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; font-size: 12px; color: rgba(255,255,255,.65); }
  .phero__crumbs a:hover { color: #fff; }
  .phero__crumbs [aria-current] { color: #fff; }
  .phero__title { max-width: 900px; font-weight: 700; font-size: clamp(32px, 4vw, 72px); line-height: 1.12; letter-spacing: -0.01em; text-transform: uppercase; }
  .phero__text { max-width: 560px; margin-top: 22px; font-weight: 300; font-size: clamp(16px, 1.1vw, 20px); line-height: 1.4; color: rgba(255,255,255,.9); }
  .phero__aside { position: absolute; right: clamp(16px, 6vw, 120px); bottom: clamp(48px, 6vw, 88px); padding-left: 16px; border-left: 1.25px solid rgba(255,255,255,.6); font-size: 13px; line-height: 1.5; letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.9); }
  /* Кнопка «вниз» — как .hero__down на главной */
  .phero__down {
    position: absolute; left: 50%; bottom: 22px; translate: -50% 0;
    display: grid; place-items: center; width: 41px; height: 40px; border-radius: 100px;
    border: 1px solid rgba(251,253,255,.5); color: #fbfdff; transition: background .25s, color .25s;
    animation: phero-bob 2.4s ease-in-out infinite;
  }
  .phero--down .phero__inner { padding-bottom: max(clamp(48px, 6vw, 88px), 84px); }
  .phero__down:hover { background: #fbfdff; color: var(--green-900); }
  @keyframes phero-bob { 50% { transform: translateY(6px); } }
  /* Приближение фото — как .hero__bg на главной: масштаб не меньше 1, поэтому края кадра не открываются.
     Только на компьютере: на телефоне и планшете фото первых экранов статичны */
  @media (min-width: 861px) { .phero--zoom .phero__bg { transform-origin: 50% 50%; animation: phero-zoom 14s var(--ease) forwards; will-change: transform; } }
  @keyframes phero-zoom { from { transform: scale(1); } to { transform: scale(1.06); } }
  @media (prefers-reduced-motion: reduce) { .phero__down, .phero--zoom .phero__bg { animation: none; } }
  @media (min-width: 861px) { .phero__down--mobile { display: none; } }
  @media (min-width: 861px) { .phero--tall { min-height: max(600px, 100svh); } }
  /* На экране во всю высоту текст не прижимаем к самому низу, а поднимаем ближе к середине — взгляд сразу попадает на заголовок
     (О нас, Услуги, Объекты, Партнерам, Вакансии; у «Контактов» и страниц вакансий экран низкий — там без изменений) */
  /* Заголовок на всех таких страницах стоит на одной высоте: описание под ним «висит» ниже (absolute) и не поднимает заголовок вверх */
  @media (min-width: 861px) {
    .phero--tall .phero__inner { padding-bottom: clamp(150px, 25svh, 280px); }
    /* подпись справа («Больше, чем остекление», «Профессионализм…») — ниже заголовка, на одной линии с описанием:
       верх подписи = верх описания (низ заголовка + отступ описания 22px) */
    .phero--tall .phero__aside { bottom: auto; top: calc(100% - clamp(150px, 25svh, 280px) + 22px); }
    .phero--tall .phero__head { position: relative; }
    .phero--tall .phero__text { position: absolute; top: 100%; left: 0; }
  }
  /* Телефон и планшет: первые экраны основных страниц одинаковые — фото на весь экран, заголовок на одной высоте (есть описание или нет),
     внизу кнопка со стрелкой. Смежные страницы (mobileLow) этого не касается */
  @media (max-width: 860px) {
    /* --pb — отступ от низа экрана до заголовка: нижняя граница подобрана так, чтобы 4 строки описания («О нас») не доходили до кнопки */
    .phero:not(.phero--mlow) { --pb: clamp(170px, calc(24svh - 20px), 200px); min-height: 100svh; }
    /* снизу плотнее: текст лежит на фото целиком, в том числе на светлых его частях */
    .phero:not(.phero--mlow) .phero__shade { background: linear-gradient(0deg, rgba(15,36,38,.62) 0%, rgba(15,36,38,.42) 30%, rgba(15,36,38,0) 52%), linear-gradient(90deg, rgba(15,36,38,.82) 0%, rgba(15,36,38,.45) 55%, rgba(15,36,38,.2) 100%), linear-gradient(180deg, rgba(15,36,38,.55) 0%, rgba(15,36,38,0) 30%); }
    .phero:not(.phero--mlow) .phero__inner { padding-bottom: var(--pb); }
    .phero:not(.phero--mlow) .phero__head { position: relative; }
    .phero:not(.phero--mlow) .phero__text { position: absolute; top: 100%; left: 0; margin-top: 16px; line-height: 1.3; }
    /* заголовок встаёт на место описания: ниже на свою высоту и отступ описания */
    .phero.phero--mtitle-low .phero__inner { padding-bottom: calc(var(--pb) - 52px); }
    .phero__down { bottom: 40px; }
  }
  /* маленькие телефоны: описание в 5 строк не должно наезжать на кнопку, длинные слова в заголовке — помещаться в ширину */
  @media (max-width: 360px), (max-width: 860px) and (max-height: 620px) { .phero:not(.phero--mlow) { --pb: 195px; } }
  @media (max-width: 860px) {
    .phero.phero--mshort { min-height: calc(100svh * 2 / 3); }
    .phero.phero--mshort .phero__inner { padding-bottom: 112px; }
  }
  @media (max-width: 360px) { .phero:not(.phero--mlow) .phero__title { font-size: 28px; } }
  @media (max-width: 860px) { .phero__aside { display: none; } }
</style>
