---
// Карточка услуги (страницы «Услуги» и «Архитекторам и дизайнерам»): фото на всю карточку 6:5, название снизу,
// с href — ссылка (на страницу услуги или на «Услуги»), без него клик открывает заявку с названием услуги.
// Без img — заглушка с фирменным паттерном.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props { title: string; img?: ImageMetadata; href?: string; }
const { title, img, href } = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag class="scard" href={href} type={href ? undefined : 'button'} data-lead={href ? undefined : title}>
  {img
    ? <Image src={img} alt="" class="scard__img" widths={[480, 800]} sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 400px" />
    : <span class="scard__stub"><span class="pattern pattern--light"></span><Icon name="sliders" size={56} stroke={1} /></span>}
  <span class="scard__shade"></span>
  <span class="scard__shine"></span>
  <span class="scard__title">{title}</span>
  <span class="icon-btn icon-btn--light scard__arrow"><Icon name="arrow-right" size={15} /></span>
</Tag>

<style>
  /* Как карточки «Объектов» (ProjectCard): чуть шире высоты (6:5, «квадрат пошире» — просьба пользователя), без рамки */
  .scard { position: relative; display: block; width: 100%; aspect-ratio: 6 / 5; overflow: hidden; padding: 0; background: var(--line); border: 0; border-radius: 9px; color: var(--white); text-align: left; cursor: pointer; isolation: isolate; }
  .scard__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease); }
  .scard__stub { position: absolute; inset: 0; display: grid; place-items: center; color: rgba(251,253,255,.35); transition: transform .8s var(--ease); }
  .scard__stub .pattern { opacity: .08; }
  /* Затемнение снизу под названием — то же, что у карточек «Объектов» (.pcard__shade) */
  .scard__shade { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(61,74,71,.92) 0%, rgba(61,74,71,.6) 30%, rgba(61,74,71,0) 62%); }
  .scard__shine { position: absolute; top: 0; bottom: 0; left: -100%; width: 100%; background: linear-gradient(115deg, transparent 42%, rgba(251,253,255,.25) 50%, transparent 58%); transition: left .9s var(--ease); }
  .scard__title { position: absolute; left: 20px; right: 64px; bottom: 20px; font-weight: 700; font-size: 18px; line-height: 1.3; text-transform: uppercase; }
  .scard__arrow { position: absolute; right: 16px; bottom: 18px; width: 32px; height: 32px; }
  .scard:hover .scard__img, .scard:hover .scard__stub { transform: scale(1.06); }
  .scard:hover .scard__shine { left: 100%; }
  .scard:hover .scard__arrow { background: var(--white); color: var(--green-900); }
  .scard:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media (max-width: 640px) {
    .scard__title { font-size: 16px; }
  }
</style>
