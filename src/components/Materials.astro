---
// «Материалы для воплощения идей» (страница «Архитекторам и дизайнерам»): вкладки «Стекло» / «Алюминий»,
// под ними маленькие вертикальные карточки в одну строку (данные — src/data/materials.ts). Фон тёмный («Зелёный мох»).
// Если у вида несколько фото — карточки лежат стопкой: следующие чуть выглядывают справа.
// Ведёшь мышкой по стопке слева направо — вперёд по очереди выходит карточка под курсором; на телефоне — касанием.
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import { glass, aluminium, type Material } from '../data/materials';

interface Props { id?: string; }
const { id } = Astro.props;

const tabs: { id: string; label: string; items: Material[] }[] = [
  { id: 'glass', label: 'Стекло', items: glass },
  { id: 'alu', label: 'Алюминий', items: aluminium },
];
---
<section class="section section--dark mats" id={id} data-mats>
  <div class="pattern pattern--fade-right"></div>
  <div class="container">
    <SectionHead title="Материалы для воплощения идей">
      <p class="tagline">Эстетика в деталях</p>
    </SectionHead>

    <div class="filters mats__tabs reveal" role="tablist" aria-label="Материал">
      {tabs.map((t, i) => (
        <button type="button" role="tab" id={`mats-tab-${t.id}`} aria-controls={`mats-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'}
          class:list={['filters__btn', { 'is-active': i === 0 }]} data-mats-tab={t.id}>{t.label}</button>
      ))}
    </div>

    <div class="mats__panels">
    {tabs.map((t, i) => (
      <div class:list={['mats__row reveal', `mats__row--${t.id}`, { 'is-shown': i === 0 }]} id={`mats-${t.id}`} role="tabpanel" aria-labelledby={`mats-tab-${t.id}`} data-off={i > 0 ? '' : undefined} inert={i > 0} data-mats-panel={t.id}>
        {t.items.map((m, k) => (
          <figure class="mat" style={`--k:${k}`}>
            <div class:list={['mat__stack', { 'mat__stack--many': m.images.length > 1 }]} style={`--n:${m.images.length}`}
              data-mat-stack tabindex={m.images.length > 1 ? 0 : undefined} aria-label={m.images.length > 1 ? `${m.title}: ${m.images.length} варианта, листайте` : undefined}>
              {m.images.map((img, j) => (
                <Image src={img} alt={`${m.title}${m.images.length > 1 ? `, вариант ${j + 1}` : ''}`} class="mat__card" style={`--i:${j};--d:${j};z-index:${m.images.length - j}`}
                  widths={[240, 480]} sizes="240px" data-mat-card />
              ))}
            </div>
            <figcaption class="mat__title">{m.title}</figcaption>
            {m.images.length > 1 && (
              <span class="mat__dots" aria-hidden="true">{m.images.map((_, j) => <span class:list={['mat__dot', { 'is-active': j === 0 }]}></span>)}</span>
            )}
          </figure>
        ))}
      </div>
    ))}
    </div>
  </div>
</section>

<style>
  .mats .container { position: relative; }
  .mats__tabs { margin-block: 32px 40px; }
  /* Подпись «Эстетика в деталях» — у правого края, по нижней линии заголовка */
  @media (min-width: 1025px) {
    .mats :global(.sec-head) { grid-template-columns: 1fr auto; align-items: end; }
    .mats :global(.sec-head__aside) { padding: 0 0 8px; }
  }
  /* Вкладки на тёмном фоне: обычная — прозрачная со светлой рамкой, выбранная — «Бумага» с текстом мхом */
  .mats .filters__btn { background: transparent; border-color: rgba(251,253,255,.3); color: rgba(251,253,255,.75); }
  .mats .filters__btn:hover { border-color: rgba(251,253,255,.7); color: var(--white); }
  .mats .filters__btn.is-active { background: var(--white); border-color: var(--white); color: var(--green-900); }

  /* Обе вкладки лежат в одной ячейке — высота экрана при переключении не меняется (по самой высокой вкладке) */
  .mats__panels { display: grid; }
  .mats__row { grid-area: 1 / 1; }
  .mats__row[data-off] { visibility: hidden; }

  /* Ширина карточки: у стекла видов мало — карточки крупнее, у алюминия 7 систем — мельче, чтобы встали в одну строку */
  .mats__row { --peek: 18px; display: flex; justify-content: center; align-items: flex-start; gap: 40px; }
  .mats__row--glass { --cw: clamp(150px, 13vw, 220px); }
  .mats__row--alu { --cw: clamp(118px, 9.6vw, 150px); gap: 20px; }

  .mat { margin: 0; display: grid; justify-items: start; gap: 12px; opacity: 0; transform: translateY(16px); transition: opacity .6s var(--ease), transform .6s var(--ease); transition-delay: calc(var(--k) * 80ms); }
  .mats__row.is-shown .mat { opacity: 1; transform: none; }

  .mat__stack { position: relative; width: calc(var(--cw) + (var(--n) - 1) * var(--peek)); height: calc(var(--cw) * 4 / 3); }
  .mat__stack--many { cursor: pointer; }
  .mat__stack:focus-visible { outline: 2px solid var(--brand-pastel); outline-offset: 4px; border-radius: 9px; }
  /* Карточка стопки: место фиксировано (сдвиг на --peek), задние — чуть меньше и темнее; --d — удалённость от передней */
  .mat__card {
    position: absolute; top: 0; left: calc(var(--i) * var(--peek)); width: var(--cw); height: 100%; object-fit: cover;
    border-radius: 9px; box-shadow: 0 12px 28px -12px rgba(0,0,0,.5);
    transform: scale(calc(1 - var(--d) * .05)); filter: brightness(calc(1 - var(--d) * .07));
    transition: transform .45s var(--ease), filter .45s var(--ease);
  }
  .mat__stack:not(.mat__stack--many):hover .mat__card { transform: translateY(-4px); }

  .mat__title { font-weight: 700; font-size: 13px; line-height: 1.3; letter-spacing: .04em; text-transform: uppercase; color: var(--white); max-width: var(--cw); }
  .mats__row--alu .mat__title { font-size: 11px; }
  .mat__dots { display: flex; gap: 5px; margin-top: -4px; }
  .mat__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--brand-pastel); opacity: .45; transition: background .3s, opacity .3s; }
  .mat__dot.is-active { background: var(--white); opacity: 1; }

  /* Планшет и телефон: строка листается пальцем вбок */
  @media (max-width: 1024px) {
    .mats__row { justify-content: flex-start; overflow-x: auto; margin-inline: calc(var(--gutter) * -1); padding: 4px var(--gutter) 12px; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); scrollbar-width: none; gap: 20px; }
    .mats__row::-webkit-scrollbar { display: none; }
    .mats__row--glass, .mats__row--alu { --cw: 150px; }
    .mat { scroll-snap-align: start; flex: none; }
  }
  @media (max-width: 640px) {
    .mats__tabs { margin-block: 24px 28px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-mats]').forEach((root) => {
    // Вкладки
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-mats-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-mats-panel]')];
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((x) => { x.classList.toggle('is-active', x === t); x.setAttribute('aria-selected', String(x === t)); });
      panels.forEach((p) => {
        const on = p.dataset.matsPanel === t.dataset.matsTab;
        p.toggleAttribute('data-off', !on);
        p.inert = !on;
        p.classList.remove('is-shown');
        // is-visible — сразу показать саму строку (.reveal), is-shown — запустить появление карточек по очереди
        if (on) { p.classList.add('is-visible'); requestAnimationFrame(() => requestAnimationFrame(() => p.classList.add('is-shown'))); }
      });
    }));

    // Стопки
    root.querySelectorAll<HTMLElement>('.mat__stack--many').forEach((stack) => {
      const cards = [...stack.querySelectorAll<HTMLElement>('[data-mat-card]')];
      const dots = [...(stack.parentElement?.querySelectorAll<HTMLElement>('.mat__dot') ?? [])];
      const n = cards.length;
      let active = 0;
      const show = (i: number) => {
        active = (i + n) % n;
        cards.forEach((c, j) => {
          const d = Math.abs(j - active);
          c.style.setProperty('--d', String(d));
          c.style.zIndex = String(n - d);
        });
        dots.forEach((dot, j) => dot.classList.toggle('is-active', j === active));
      };
      // мышь: стопка делится по ширине на n полос — какая под курсором, та и впереди
      stack.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse') return;
        const r = stack.getBoundingClientRect();
        const i = Math.min(n - 1, Math.max(0, Math.floor(((e.clientX - r.left) / r.width) * n)));
        if (i !== active) show(i);
      });
      stack.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') show(0); });
      // касание и клавиатура: следующая карточка
      stack.addEventListener('click', (e) => { if ((e as PointerEvent).pointerType !== 'mouse') show(active + 1); });
      stack.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'Enter' || e.key === ' ') { e.preventDefault(); show(active + 1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); show(active - 1); }
      });
    });
  });
</script>
