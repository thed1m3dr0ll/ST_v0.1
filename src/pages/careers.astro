---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import ResumeModal from '../components/ResumeModal.astro';
import heroTeam from '../assets/careers/hero-people-80-hd.jpg'; // фото 80, увеличенное до 2560 px — готовит tools/prep-careers.cjs
import { vacancies } from '../data/vacancies';

// Тексты и порядок — из «для сайта/Текстовый документ.md»
const perks = [
  { title: 'Официальное трудоустройство', text: 'Оформление согласно Трудовому кодексу РФ.' },
  { title: 'Комфортное рабочее пространство', text: 'Офис в центре города, оборудованная кухня, чай, кофе и угощения.' },
  { title: 'Развитие и новые задачи', text: 'Возможность осваивать новые навыки, проходить профильное обучение и развиваться профессионально.' },
  { title: 'Командное взаимодействие', text: 'Прямое общение с руководством, взаимопонимание в коллективе, совместные праздники и внимание к персональным событиям сотрудников.' },
  { title: 'Поддержка и понимание', text: 'Учитываем, что у сотрудников могут возникать семейные обстоятельства, требующие особого внимания и гибкого подхода.' },
];
---
<Base title="Вакансии" description="Работа в Стекляника: вакансии технолога-конструктора и инженера-конструктора. Присоединяйтесь к команде.">
  <PageHero
    title="Вакансии"
    text="Мы открыты для талантливых и инициативных специалистов, которые разделяют наши ценности."
    image={heroTeam}
    position="50% 30%"
    mobilePosition="50% 30%"
    quality={90}
    imageSizes="(max-aspect-ratio: 16/9) 178vh, 100vw"
    crumbs={[{ label: 'Вакансии' }]}
    aside={'Профессионализм.\nРазвитие.\nКоманда.'}
    tall
    down="#perks"
  />

  <section class="section perks-sec" id="perks">
    <div class="pattern pattern--fade-right"></div>
    <div class="container">
      <SectionHead title="Что мы предлагаем" />
      <ul class="perks">
        {perks.map((p, i) => (
          <li class="perks__item reveal" style={`--d:${i * 700}ms`}>
            <div class="perks__card">
              <h3 class="perks__title">{p.title}</h3>
              <p class="perks__text">{p.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section vac">
    <div class="container">
      <SectionHead eyebrow="Актуальная информация" title="Вакансии" text="Не нашли подходящую вакансию? Отправьте резюме — мы свяжемся, когда появится место." />
      {vacancies.length === 0 && <p class="vac__none reveal">Сейчас открытых вакансий нет, но мы всегда рады талантливым специалистам — отправьте резюме, и мы свяжемся с вами, когда появится подходящее место.</p>}
      {vacancies.length > 0 && <ul class="vac__list">
        {vacancies.map((v) => (
          <li class="vac__item reveal">
            <div class="vac__main">
              <h3 class="vac__title">{v.title}</h3>
              <p class="vac__meta">
                <span><Icon name={v.place === 'Офис' ? 'office' : 'factory'} size={14} />{v.place}</span>
                <span class="vac__dot" aria-hidden="true">·</span>
                <span>{v.employment}</span>
              </p>
            </div>
            <a class="btn" href={`/careers/${v.slug}/`}>Подробнее <Icon name="arrow-right" /></a>
          </li>
        ))}
      </ul>}
      <div class="vac__cv">
        <p>Не нашли подходящую вакансию? Отправьте резюме, чтобы специалисты могли рассмотреть вашу кандидатуру в будущем.</p>
        <button type="button" class="btn" data-resume="Отправить резюме">Отправить резюме <Icon name="arrow-right" /></button>
      </div>
    </div>
  </section>
  <ResumeModal />
</Base>

<style>
  /* «Что мы предлагаем»: 5 белых карточек одной высоты в одну линию на светло-зелёном фоне.
     Появляются по очереди (задержка --d): падают сверху и с лёгким отскоком встают на место.
     При наведении карточка приподнимается и становится мхом. */
  .perks-sec { background: linear-gradient(180deg, rgba(153,186,184,.3), rgba(153,186,184,.16)), var(--bg); }
  .perks { position: relative; display: grid; grid-template-columns: repeat(5, 1fr); grid-auto-rows: 1fr; gap: 12px; margin-top: 40px; }
  .perks__item { display: flex; flex-direction: column; }
  .perks__item.reveal { transform: translateY(-70px); transition: opacity .9s var(--ease) var(--d, 0ms), transform 1s cubic-bezier(.22, 1.3, .36, 1) var(--d, 0ms); }
  .perks__item.reveal.is-visible { transform: none; }
  .perks__card {
    flex: 1; display: flex; flex-direction: column; gap: 10px; padding: 22px 20px 24px;
    border-radius: 9px;
    background: var(--white);
    color: var(--brand-moss);
    transition: transform .35s var(--ease), background-color .35s var(--ease), color .35s var(--ease), box-shadow .35s var(--ease);
  }
  .perks__item:hover .perks__card {
    transform: translateY(-6px) scale(1.035);
    background: var(--brand-moss); color: var(--white);
    box-shadow: 0 30px 50px -26px rgba(61,74,71,.7);
  }
  .perks__title { font-weight: 700; font-size: clamp(16px, 1.2vw, 20px); line-height: 1.3; text-transform: uppercase; letter-spacing: .02em; color: inherit; }
  .perks__text { font-size: clamp(13px, .85vw, 15px); line-height: 1.55; color: inherit; }
  @media (max-width: 1180px) { .perks { grid-template-columns: repeat(3, 1fr); row-gap: 28px; } }
  @media (max-width: 760px) { .perks { grid-template-columns: repeat(2, 1fr); } }
  @media (prefers-reduced-motion: reduce) { .perks__item.reveal { transform: none; transition: none; } }
  .vac { background: linear-gradient(180deg, #f3f7f6, var(--bg)); }
  .vac__none { margin-top: 40px; padding: 24px; max-width: 900px; border: 1px solid var(--line); border-radius: 9px; background: var(--white); line-height: 1.55; color: var(--brand-moss); }
  .vac__list { display: grid; gap: 10px; margin-top: 40px; }
  .vac__item { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 24px; background: var(--white); border: 1px solid var(--line); border-radius: 9px; transition: box-shadow .3s, border-color .3s; }
  .vac__item:hover { border-color: var(--icon-border); box-shadow: 0 24px 40px -30px rgba(22,39,41,.35); }
  .vac__title { font-weight: 700; font-size: 18px; text-transform: uppercase; color: var(--navy); }
  .vac__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin-top: 10px; font-size: 14px; color: var(--text-2); }
  .vac__dot { font-weight: 700; }
  .vac__meta span { display: inline-flex; align-items: center; gap: 6px; }
  .vac__cv { display: flex; align-items: center; justify-content: space-between; gap: 16px 32px; flex-wrap: wrap; margin-top: 24px; padding: 24px 28px; border-radius: 9px; background: var(--green-900); color: #fff; font-weight: 500; }
  .vac__cv p { max-width: 720px; line-height: 1.5; }
  .vac__cv .btn { --btn-bg: #fff; --btn-fg: var(--green-900); --btn-bd: #fff; }
  .vac__cv .btn:hover { --btn-bg: var(--accent); --btn-fg: #fff; --btn-bd: var(--accent); }
  @media (max-width: 640px) {
    .perks { grid-template-columns: 1fr; grid-auto-rows: auto; row-gap: 20px; margin-top: 28px; }
    .perks__item.reveal { transition-delay: 0ms; } /* в столбик каждая карточка появляется сама по мере прокрутки */
    .perks__card { padding: 22px 18px; }
    .vac__item { flex-direction: column; align-items: flex-start; padding: 20px 16px; }
    .vac__title { font-size: 16px; }
  }
</style>
