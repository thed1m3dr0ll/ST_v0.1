---
// «Девелоперам» (/partners/developers/) — страница аудитории, открывается с карточки на «Партнерам».
// Светлый первый экран (текст + фото-трапеция, шапка сразу залита) → «Комплексный подход» (два блока: мы / вы) →
// «Реализованные объекты» (карусель с «Партнерам», карточки ЖК со страницы «Объекты») → светлая полоса «Обсудим ваш проект» с фото (форма заявки) → подвал.
import Base from '../../layouts/Base.astro';
import SplitHero from '../../components/SplitHero.astro';
import TwoSides from '../../components/TwoSides.astro';
import Projects from '../../components/home/Projects.astro';
import ObjectModal from '../../components/ObjectModal.astro';
import CtaBand from '../../components/CtaBand.astro';
import { projects } from '../../data/projects';
// Фото первого экрана — «для сайта/девелоперам» (tools/prep-developers.cjs); позже можно заменить
import heroImg from '../../assets/developers/hero.jpg';
// Фото для полосы «Обсудим ваш проект» — ЖК «Плотничный» (изогнутый остеклённый фасад)
import ctaImg from '../../assets/developers/cta-plotnichny.jpg';

const sides = [
  {
    title: 'Что обеспечиваем мы',
    items: [
      { title: 'Полный цикл работ', text: 'Проектирование, инженерная проработка, изготовление конструкций, логистика и монтаж в рамках одной компании.' },
      { title: 'Технические решения под задачи объекта', text: 'Подбор систем и проработка конструкций с учётом проектной документации, характеристик объекта и требований к остеклению.' },
      { title: 'Согласованность этапов работ', text: 'Взаимосвязь проектирования, производства и монтажа, контроль выполнения работ на ключевых этапах.' },
    ],
  },
  {
    title: 'Что получаете вы',
    items: [
      { title: 'Один исполнитель', text: 'Не нужно самостоятельно искать и координировать несколько подрядчиков для реализации остекления.' },
      { title: 'Решения, соответствующие проекту', text: 'Конструкции подбираются с учётом технических требований и особенностей конкретного объекта.' },
      { title: 'Единый процесс реализации', text: 'Согласованная работа над связанными этапами помогает избежать разрозненности решений и упростить взаимодействие.' },
    ],
  },
];

// «Реализованные объекты» — все объекты из группы «Жилые комплексы» на странице «Объекты» (в том же порядке).
// Новый ЖК, добавленный в админке, появится здесь сам.
const residential = projects.filter((p) => p.type === 'residential');
---
<Base solidHeader title="Девелоперам" description="«Стекляника» — алюминиевое остекление для проектов жилой и коммерческой недвижимости: проектирование, производство и монтаж в рамках одной компании.">
  <SplitHero
    title="Девелоперам"
    text="«Стекляника» специализируется на алюминиевом остеклении и участвует в реализации проектов жилой и коммерческой недвижимости. Опыт работы с различными объектами позволяет находить технические решения, соответствующие архитектурным задачам и требованиям проекта."
    image={heroImg}
    alt="Специалист с чертежами у строящегося здания со стеклянным фасадом"
    crumbs={[{ label: 'Партнерам', href: '/partners/' }, { label: 'Девелоперам' }]}
    position="38% 50%"
    down="#approach"
  />

  <TwoSides id="approach" title="Комплексный подход к реализации проекта" sides={sides} />

  <Projects title="Реализованные объекты" text="" items={residential} rounded />

  <CtaBand
    title="Обсудим ваш проект"
    text="Подключение к новому проекту начинается с понимания его задач и требований к остеклению. Расскажите об объекте — обсудим возможные технические решения, объём работ и дальнейшие шаги."
    button="Обсудить проект"
    light
    image={ctaImg}
    position="50% 45%"
  />

  <ObjectModal projects={residential} />
</Base>
