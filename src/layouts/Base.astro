---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadModal from '../components/LeadModal.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { site } from '../data/site';
import { organizationLd } from '../data/seo';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultShareImage from '../assets/hero.jpg';
import logo from '../assets/brand/logo-dark.png';

// solidHeader — шапка сразу залита «Зелёным мхом» (как после прокрутки): для страниц со светлым первым экраном
// image — картинка превью, когда ссылку на страницу пересылают в соцсетях и мессенджерах (по умолчанию — фото с главной)
// noindex — страницу не показывать в поиске (документы, 404)
interface Props { title?: string; description?: string; solidHeader?: boolean; image?: ImageMetadata; noindex?: boolean; }
const { title, description = site.description, solidHeader = false, image = defaultShareImage, noindex = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — светопрозрачные конструкции под ключ`;

// Адрес сайта — astro.config.mjs → site. Превью ссылок требует полных адресов (с доменом)
const siteUrl = Astro.site ?? Astro.url;
const abs = (path: string) => new URL(path, siteUrl).href;
const pageUrl = abs(Astro.url.pathname);
// превью 1200×630 — размер, который соцсети и мессенджеры показывают крупной картинкой
const shareOf = (src: ImageMetadata) => getImage({ src, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const share = await shareOf(image);
const logoImg = await getImage({ src: logo, width: 512, format: 'png' });
const companyImg = image === defaultShareImage ? share : await shareOf(defaultShareImage);
const ld = organizationLd(new URL('/', siteUrl), abs(logoImg.src), abs(companyImg.src));
const robots = !site.indexable ? 'noindex, nofollow' : noindex ? 'noindex, follow' : '';
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#3d4a47" />
    {robots && <meta name="robots" content={robots} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={abs(share.src)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ru_RU" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/CeraPro-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/CeraPro-Bold.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body id="top">
    <Header solid={solidHeader} />
    <main>
      <slot />
    </main>
    <Footer />
    <LeadModal />
    <CookieBanner />

    <script>
      // Плавное появление блоков с классом .reveal
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
        });
      }, { rootMargin: '0px 0px -5% 0px', threshold: 0 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Телефон: приближать двумя пальцами можно, но когда все пальцы убраны, масштаб возвращается к обычному.
      // Браузер сбрасывает масштаб, если на мгновение запретить приближение. На компьютере не работает — там масштаб как обычно
      const viewport = document.querySelector<HTMLMetaElement>('meta[name="viewport"]');
      if (viewport && window.visualViewport && matchMedia('(hover: none) and (pointer: coarse)').matches) {
        const normal = viewport.content;
        window.addEventListener('touchend', (e) => {
          if (e.touches.length > 0 || window.visualViewport!.scale <= 1.01) return;
          viewport.content = `${normal}, maximum-scale=1`;
          setTimeout(() => { viewport.content = normal; }, 300);
        }, { passive: true });
      }
    </script>
  </body>
</html>
